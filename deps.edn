{:paths ["src"]
 ;; datom-source is the only runtime dependency, and it is itself zero-dep
 ;; portable .cljc. It is here rather than reimplemented because
 ;; `IPatternSource` is the declared seam every kotobase query path plugs
 ;; into -- a second definition of that protocol would be a second thing for
 ;; a query surface to fail to recognise.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; The execution engine the scan path runs on. Zero-dep itself, so the
        ;; transitive cost of pulling it in is nil, and the lake's read side
        ;; genuinely needs an engine — kotobase.lake.columnar is the ten-line
        ;; join between them.
        io.github.kotoba-lang/columnar
        {:git/url "https://github.com/kotoba-lang/columnar.git"
         :git/sha "6e417bc70b530c0ae9d5236cadd30e3ce6df5b6a"}
        io.github.kotoba-lang/datom-source
        {:git/url "https://github.com/kotoba-lang/datom-source.git"
         :git/sha "3a99b1b1fb2d2f8736995076eb1ab5f94f0808b7"}
        ;; N-Triples. The one format whose decoded output IS this repo's datom
        ;; shape -- RDF statements are subject-predicate-object -- so the
        ;; adapter is a term-to-value mapping rather than a decoder, and it
        ;; belongs where the datom shape is defined. Zero-dep portable .cljc,
        ;; so the transitive cost is nil. Parquet and Arrow stay OUT of this
        ;; repo's deps for the opposite reason: they need byte-range machinery
        ;; the lake has no business carrying.
        io.github.kotoba-lang/org-w3-nquads
        {:git/url "https://github.com/kotoba-lang/org-w3-nquads.git"
         :git/sha "794846ca2e718f0b390b0856a8487bc40fa43323"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; The same portable suite under real ClojureScript. Not a duplicate of the
  ;; JVM run: `sniff/prefix` has a reader conditional per platform, and the
  ;; runtime this library actually deploys on (a Worker) is the cljs one.
  :cljs {:extra-paths ["test"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
